# Copy to .env and fill in. Never commit .env.
#
# Every variable the server reads is listed here, including the ones it will start without.
# Those are the dangerous ones: the server boots, looks healthy, and is quietly missing a
# security control. Each is marked with what actually happens when it is absent.


# ── Database ────────────────────────────────────────────────────────────────────────────
# From https://app.supabase.com → Settings → API.
SUPABASE_URL=https://your-project.supabase.co

# Prefer the service_role key. The backend is the only database client — no browser or
# mobile app talks to Supabase directly — so it authenticates as service_role and keeps
# full access with Row-Level Security enabled on every table.
# NOTE: service_role BYPASSES RLS. RLS protects against direct REST abuse of the database,
# not against a hole in this API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Fallback if the service key is unset. Fine for local work, not for a real deployment.
SUPABASE_ANON_KEY=your-anon-key-here
# Third fallback, kept only so older deployments keep booting. Set one of the two above.
SUPABASE_KEY=


# ── Sessions ────────────────────────────────────────────────────────────────────────────
# Signs the login session. Any long random string: `openssl rand -hex 48`.
# IF UNSET: the server generates a random secret per process instead of refusing to start —
# a fixed fallback would let anyone mint a session for any shop. Everyone is signed out on
# every restart, and on a free host that sleeps when idle, that is constant. Check
# GET /api/health → auth.sessionSecret: "configured" means this is set.
JWT_SECRET=

# "true" turns the session gate on. Anything else runs it in report-only: every check still
# runs and logs what it would have refused, but nothing is blocked.
# IF NOT "true": ANY caller holding a shop's UUID can read and write that shop. This exists
# so an app build already on a shopkeeper's phone keeps working during a rollout; set it to
# true once every client sends a token. Check GET /api/health → auth.enforced.
AUTH_ENFORCE=false


# ── Server-to-server secrets ────────────────────────────────────────────────────────────
# Authenticates POST /api/webhooks/online-order, which an online store calls after a paid
# order to bill it and decrement stock. Must match the caller's x-webhook-secret.
# IF UNSET: the route answers 503 and online orders stop syncing to inventory.
ONLINE_ORDER_SECRET=

# Authenticates POST /api/recurring-invoices/run-due, the daily job that generates every
# shop's due recurring invoices. It spans all shops, so no session can scope it. Must match
# the RECURRING_CRON_SECRET repository secret used by .github/workflows/recurring-invoices.yml.
# IF UNSET: the route answers 503 and recurring invoices silently stop being generated.
RECURRING_CRON_SECRET=


# ── Server ──────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Comma-separated origins allowed to call the API from a browser, e.g.
# https://app.example.com,https://example.com
# IF UNSET: CORS is open to every origin, and the server logs a warning at boot. Lower risk
# than it sounds here, because the session travels in a header rather than a cookie, so a
# third-party page still cannot read anything without a token.
ALLOWED_ORIGINS=


# ── Optional AI features ────────────────────────────────────────────────────────────────
# Each of these only disables its own feature when unset; nothing else breaks.
GEMINI_API_KEY=          # product photo identification, AI business queries
HF_TOKEN=                # Hugging Face inference, reported by /api/health
OLLAMA_URL=              # local model endpoint, used only if you run one
